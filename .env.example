# ============================================
# OpenCode WebUI - 环境变量
# ============================================
# cp .env.example .env

# ---- LLM Provider API Keys（至少填一个）----
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
XAI_API_KEY=

# ---- 端口 ----
GATEWAY_PORT=6658
PREVIEW_PORT=6659

# ---- 预览域名（绑定独立域名解决前端资源路径问题）----
# 例如 preview.example.com，Nginx 将此域名转发到 PREVIEW_PORT
PREVIEW_DOMAIN=

# ---- 工作目录 ----
WORKSPACE=./workspace

# ---- 安全（公网部署务必设置）----
# 页面与后端共用同一套账号口令：主部署方式下非空即同时开启
# 页面访问认证（浏览器弹窗）与后端 API 认证；清空则两者同时关闭。
OPENCODE_SERVER_PASSWORD=
OPENCODE_SERVER_USERNAME=opencode

# ---- 路由服务（由 gateway 内置）----
PUBLIC_BASE_URL=
ROUTER_SCAN_INTERVAL=5
ROUTER_TOKEN_LENGTH=12
ROUTER_PORT_RANGE=3000-9999
ROUTER_EXCLUDE_PORTS=4096

# ---- Reasonix Web UI 反代（可选，docker/Caddyfile.reasonix）----
# 前端容器 :3001 整站反代 reasonix serve 自带的 Web UI（IP 直连
# http://<IP>:3001）。默认 127.0.0.1:8787 = 未启用（访问 :3001 得 502）。
#   容器化 reasonix（opencodeui-reasonix 镜像）：REASONIX_URL=http://reasonix:8787
#   宿主机运行 reasonix：REASONIX_URL=host.docker.internal:8787
#     （需 reasonix --addr 0.0.0.0:8787 + compose 加 extra_hosts host-gateway）
# 认证由 reasonix serve 自身负责，推荐 token 模式（serve 默认 none，需显式指定）：
#   reasonix serve --addr 0.0.0.0:8787 --auth token --token <长随机串> --behind-proxy
#   浏览器打开 http://<IP>:3001/#token=<token>，首次自动换 HttpOnly cookie。
#   --auth none 仅读操作开放、写操作仍需 launch token，不可信网络勿用。
# REASONIX_URL=
# REASONIX_LISTEN=:3001
# REASONIX_PORT=3001

# ---- Backend 工具链镜像/运行时源（可选）----
USE_CHINA_MIRROR=1
APT_MIRROR=http://mirrors.tuna.tsinghua.edu.cn/debian
APT_SECURITY_MIRROR=http://mirrors.tuna.tsinghua.edu.cn/debian-security
NPM_CONFIG_REGISTRY=https://registry.npmmirror.com
NODEJS_ORG_MIRROR=https://npmmirror.com/mirrors/node
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
PIP_TRUSTED_HOST=pypi.tuna.tsinghua.edu.cn
MISE_INSTALL_URL=https://mise.run
