# OpenCode WebUI - 纯前端独立部署
# 静态文件 + API 反代到外部 opencode serve
#
# 认证模型与上游一致：不代持后端凭据。客户端（网页设置里填写的账号密码、
# App 连接配置）自带 Authorization: Basic，由后端统一校验；无凭据请求
# 被后端 401 拒绝。

{
	grace_period 3s
}

:3000 {
	# opencode-mobile 专用入口：只剥 /mobile，保留 /api 前缀原样直通后端。
	# App 在连接配置中自带 Authorization: Basic（与后端进程的
	# OPENCODE_SERVER_USERNAME/PASSWORD 一致），由后端统一校验。
	handle_path /mobile/* {
		reverse_proxy {$BACKEND_URL:host.docker.internal:4096} {
			flush_interval -1
		}
	}

	# API 反代（strip /api 前缀，SSE 需要 flush_interval -1）
	# 认证与上游一致：透传客户端自带的 Authorization 头，由后端校验。
	# 后端对终端 WebSocket 握手做来源校验：保留浏览器真实 Origin/Host
	# （同源自洽）即可通过，经局域网 IP 访问也成立；跨站请求被 403。
	handle_path /api/* {
		reverse_proxy {$BACKEND_URL:host.docker.internal:4096} {
			flush_interval -1
		}
	}

	handle {
		root * /srv
		file_server
		try_files {path} /index.html
	}

	encode gzip
}

# Reasonix Web UI 反代（独立站点 :3001，可选，见 Caddyfile.reasonix）
# 认证由 reasonix serve 自身负责
import /etc/caddy/Caddyfile.reasonix
