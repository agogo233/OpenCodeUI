# OpenCode WebUI - Caddy 配置
# 纯静态文件服务

{
    grace_period 3s
}

:3000 {
    @api path /api /api/*
    handle @api {
        respond "API is not served by the frontend-only image" 404
    }

    handle {
        root * /srv
        file_server

        # SPA 路由 - 所有非文件请求返回 index.html
        try_files {path} /index.html
    }

    encode gzip
}

# Reasonix Web UI 反代（独立站点 :3001，可选，见 Caddyfile.reasonix）
import /etc/caddy/Caddyfile.reasonix
